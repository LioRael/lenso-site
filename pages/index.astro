---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Lenso — modular Rust systems with a service-ready path",
    description: config.description,
    route: "/",
  }}
>
  <main class="home-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Rust-first · agent-ready · single-region GA</p>
        <h1>Build the business system.<br /><span>Keep every boundary visible.</span></h1>
        <p class="lede">
          Lenso starts as a modular app with a runnable host, contracts, background
          work, migrations, and operator evidence. Split a module into an autonomous
          service only when its ownership and operational boundary are real.
        </p>
        <div class="actions">
          <a class="primary" href="/docs/quickstart">Build your first app</a>
          <a class="secondary" href="/docs/platform-concepts">Understand the model</a>
        </div>
        <div class="command" aria-label="Recommended first command">
          <span>$</span>
          <code>lenso app compose ./acme-support --blueprint support-desk --apply</code>
        </div>
      </div>

      <div class="aperture" aria-label="Host, module, service, and evidence meet at an explicit contract">
        <div class="trace trace-north"></div>
        <div class="trace trace-east"></div>
        <div class="trace trace-south"></div>
        <div class="trace trace-west"></div>
        <div class="node node-north"><span>HOST</span><strong>composition</strong></div>
        <div class="node node-east"><span>SERVICE</span><strong>autonomy</strong></div>
        <div class="node node-south"><span>EVIDENCE</span><strong>runtime story</strong></div>
        <div class="node node-west"><span>MODULE</span><strong>capability</strong></div>
        <div class="contract"><span>EXPLICIT</span><strong>CONTRACT</strong></div>
      </div>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <div class="section-heading">
        <p class="eyebrow">Choose the smallest public path</p>
        <h2 id="paths-title">Start from the outcome, not the infrastructure.</h2>
      </div>
      <div class="path-grid">
        <a href="/docs/product-blueprints" class="path-card">
          <span class="path-label">Business app</span>
          <h3>Compose a product-shaped app</h3>
          <p>Generate a host, services, system graph, proof state, and agent handoff from a supported blueprint.</p>
          <code>lenso app compose</code>
        </a>
        <a href="/docs/module-authoring" class="path-card">
          <span class="path-label">Rust capability</span>
          <h3>Author a linked module</h3>
          <p>Declare routes, data, actions, runtime work, and Console surfaces through the public Rust facade.</p>
          <code>lenso module create</code>
        </a>
        <a href="/docs/remote-modules" class="path-card">
          <span class="path-label">Independent process</span>
          <h3>Run a service-backed module</h3>
          <p>Keep host-owned policy and evidence while the module runs with its own language and release cadence.</p>
          <code>lenso service create</code>
        </a>
      </div>
    </section>

    <section class="proof">
      <div>
        <p class="eyebrow">Definition of done</p>
        <h2>Running is not enough. Leave proof.</h2>
      </div>
      <ol>
        <li><strong>Declare</strong><span>Manifest and contracts describe the capability.</span></li>
        <li><strong>Execute</strong><span>Host or service owns the real business effect.</span></li>
        <li><strong>Verify</strong><span>Focused checks and Runtime Console expose evidence.</span></li>
        <li><strong>Operate</strong><span>GA support, recovery, and security boundaries stay explicit.</span></li>
      </ol>
      <a href="/docs/single-region-ga">Read the GA operating model →</a>
    </section>
  </main>
</PageLayout>

<style>
  :global(body) {
    background: #f7f8fb;
  }

  .home-shell {
    --ink: #111318;
    --muted: #596171;
    --line: #dfe4ec;
    --blue: #006efe;
    --blue-soft: #eaf3ff;
    color: var(--ink);
    margin: 0 auto;
    max-width: 1240px;
    padding: 0 32px 96px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, 0.92fr);
    gap: 56px;
    align-items: center;
    min-height: 690px;
    padding: 88px 0 72px;
  }

  .eyebrow,
  .path-label {
    color: var(--blue);
    font: 700 12px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font: 650 clamp(48px, 6.2vw, 82px)/0.98 "Avenir Next", "Segoe UI", sans-serif;
    letter-spacing: -0.055em;
    margin: 22px 0 28px;
    max-width: 820px;
  }

  h1 span {
    color: var(--blue);
  }

  .lede {
    color: var(--muted);
    font: 400 19px/1.65 "Avenir Next", "Segoe UI", sans-serif;
    max-width: 700px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .actions a {
    border-radius: 8px;
    font: 650 14px/1 "Avenir Next", "Segoe UI", sans-serif;
    padding: 15px 19px;
    text-decoration: none;
  }

  .primary { background: var(--ink); color: white; }
  .secondary { border: 1px solid var(--line); color: var(--ink); }

  .actions a:focus-visible,
  .path-card:focus-visible,
  .proof > a:focus-visible {
    outline: 3px solid #79b5ff;
    outline-offset: 3px;
  }

  .command {
    align-items: center;
    background: white;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    gap: 12px;
    margin-top: 20px;
    max-width: 680px;
    overflow-x: auto;
    padding: 14px 16px;
  }

  .command span { color: var(--blue); font-weight: 800; }
  .command code { color: #273247; font-size: 12px; white-space: nowrap; }

  .aperture {
    aspect-ratio: 1;
    background:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      #fff;
    background-size: 28px 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 28px 80px rgba(35, 55, 88, 0.12);
    max-width: 520px;
    position: relative;
  }

  .node,
  .contract {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 7px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 13px 15px;
    position: absolute;
    z-index: 2;
  }

  .node span,
  .contract span { color: var(--muted); font: 700 9px/1 ui-monospace, monospace; letter-spacing: .12em; }
  .node strong { font: 650 13px/1.1 "Avenir Next", sans-serif; }
  .node-north { left: 50%; top: 9%; transform: translateX(-50%); }
  .node-east { right: 5%; top: 50%; transform: translateY(-50%); }
  .node-south { bottom: 9%; left: 50%; transform: translateX(-50%); }
  .node-west { left: 5%; top: 50%; transform: translateY(-50%); }

  .contract {
    align-items: center;
    background: var(--ink);
    border-color: var(--ink);
    color: white;
    left: 50%;
    padding: 20px 18px;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .contract span { color: #8dbfff; }
  .contract strong { font: 750 15px/1 ui-monospace, monospace; letter-spacing: .05em; }

  .trace { background: var(--blue); position: absolute; z-index: 1; }
  .trace-north, .trace-south { height: 2px; left: 50%; transform: translateX(-50%); width: 1px; }
  .trace-north { height: 34%; top: 18%; }
  .trace-south { bottom: 18%; height: 34%; }
  .trace-east, .trace-west { height: 1px; top: 50%; transform: translateY(-50%); width: 34%; }
  .trace-east { right: 17%; }
  .trace-west { left: 17%; }

  .paths,
  .proof {
    border-top: 1px solid var(--line);
    padding: 76px 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    align-items: start;
  }

  h2 {
    font: 650 clamp(34px, 4vw, 52px)/1.05 "Avenir Next", "Segoe UI", sans-serif;
    letter-spacing: -0.04em;
    margin: 0;
    max-width: 760px;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 52px;
  }

  .path-card {
    background: white;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    min-height: 285px;
    padding: 26px;
    text-decoration: none;
    transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
  }

  .path-card:hover {
    border-color: #8fbfff;
    box-shadow: 0 16px 40px rgba(34, 67, 112, .08);
    transform: translateY(-3px);
  }

  .path-card h3 { font: 650 23px/1.15 "Avenir Next", sans-serif; letter-spacing: -.025em; margin: 28px 0 14px; }
  .path-card p { color: var(--muted); font: 400 15px/1.6 "Avenir Next", sans-serif; }
  .path-card code { color: var(--blue); display: block; font-size: 12px; margin-top: 24px; }

  .proof {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 60px;
    position: relative;
  }

  .proof ol { list-style: none; margin: 0; padding: 0; }
  .proof li { border-top: 1px solid var(--line); display: grid; gap: 22px; grid-template-columns: 105px 1fr; padding: 17px 0; }
  .proof li strong { color: var(--ink); font: 700 13px/1.4 ui-monospace, monospace; }
  .proof li span { color: var(--muted); font: 400 15px/1.5 "Avenir Next", sans-serif; }
  .proof > a { bottom: 14px; color: var(--blue); font-weight: 650; left: 0; position: absolute; text-decoration: none; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 64px; }
    .aperture { justify-self: center; width: min(100%, 520px); }
    .path-grid { grid-template-columns: 1fr; }
    .path-card { min-height: 0; }
    .section-heading, .proof { grid-template-columns: 1fr; }
    .proof { padding-bottom: 124px; }
  }

  @media (max-width: 560px) {
    .home-shell { padding-inline: 20px; }
    .hero { gap: 42px; min-height: auto; }
    h1 { font-size: 46px; }
    .aperture { border-radius: 12px; }
    .node { padding: 9px; }
    .node strong { font-size: 10px; }
    .contract { padding: 14px 11px; }
    .contract strong { font-size: 11px; }
    .proof li { grid-template-columns: 82px 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .path-card { transition: none; }
  }

  :global(html.dark) .home-shell { --ink: #f2f5f9; --muted: #aab2c0; --line: #2b3340; --blue-soft: #0d2546; }
  :global(html.dark body) { background: #0c0f14; }
  :global(html.dark) .aperture { background-color: #111722; box-shadow: none; }
  :global(html.dark) .node,
  :global(html.dark) .path-card,
  :global(html.dark) .command { background: #111722; }
  :global(html.dark) .contract { background: #f4f7fb; color: #111318; }
  :global(html.dark) .command code { color: #d6deea; }
</style>
