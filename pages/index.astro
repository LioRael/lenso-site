---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import HomePage from "../islands/HomePage";

const { config } = data;
const localeSwitch = [
  {
    code: "en",
    label: "English",
    dir: "ltr" as const,
    href: "/",
    current: true,
    untranslated: false,
  },
  {
    code: "zh",
    label: "简体中文",
    dir: "ltr" as const,
    href: "/docs/zh",
    current: false,
    untranslated: false,
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  localeSwitch={localeSwitch}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Lenso",
    description: "Compose agent-ready Rust business systems from product blueprints, extend them with explicit capabilities, and evolve stable boundaries into services.",
    route: "/",
  }}
>
  <HomePage client:load />
</PageLayout>
