---
import PageLayout from "blume/components/layout/PageLayout.astro";
import type { Navigation } from "blume";
import data from "blume:data";
import HomePage from "../islands/HomePage";

const { config } = data;
const navigation: Navigation = {
  ...data.navigation,
  repoUrl: "https://github.com/LioRael/lenso",
};
const localeSwitch = [
  {
    code: "en",
    label: "English",
    dir: "ltr" as const,
    href: "/",
    current: true,
    untranslated: false,
  },
  {
    code: "zh",
    label: "简体中文",
    dir: "ltr" as const,
    href: "/docs/zh",
    current: false,
    untranslated: false,
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  localeSwitch={localeSwitch}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Lenso",
    description: "Compose an agent-ready Rust business system, run it locally, connect Console, and read exact status across modular applications and microservices.",
    route: "/",
  }}
>
  <HomePage client:load />
</PageLayout>
