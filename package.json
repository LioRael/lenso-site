{
  "name": "lenso-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "blume build",
    "check": "pnpm check:docs && blume build && pnpm check:published",
    "check:docs": "node scripts/check-docs.mjs && node scripts/sync-openapi.mjs --check",
    "check:docs:upstream": "node scripts/check-docs.mjs && node scripts/sync-openapi.mjs --check --source-ref origin/main",
    "check:published": "node scripts/check-published-output.mjs",
    "worker:build": "blume build",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "dev": "blume dev",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "preview": "blume preview",
    "start": "blume preview"
  },
  "dependencies": {
    "blume": "1.4.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@11.7.0"
}
