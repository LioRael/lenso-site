{
  "name": "lenso-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lenso-docs dev --turbopack",
    "build": "lenso-docs build && node scripts/finalize-output.mjs && node scripts/check-output.mjs",
    "preview": "lenso-docs preview",
    "start": "lenso-docs preview",
    "check:docs": "node scripts/check-content.mjs",
    "check:site-integration": "node scripts/check-site-integration.mjs",
    "types:check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings components routes docs.components.tsx docs.config.ts scripts docs.source.mjs",
    "check": "pnpm check:docs && pnpm types:check && pnpm lint && pnpm build",
    "worker:build": "pnpm build",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@lenso/docs": "0.1.0",
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "oxlint": "1.87.0",
    "wrangler": "4.103.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@11.7.0"
}
