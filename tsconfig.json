{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "docs.config.ts",
    "docs.components.tsx",
    "components/**/*.tsx",
    "routes/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".lenso",
    "legacy"
  ]
}
